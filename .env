# RAG Server — host path to codebase for indexing (mounted as /workspace/src inside container)
RAG_CODE_PATH=/Users/samtakot/devs/learnings/agent_frameworks/min/koog

# RAG Server — model settings
EMBEDDING_MODEL=nomic-embed-text:v1.5
EMBEDDING_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b-instruct
TRANSLATE_LLM_MODEL=qwen2.5-coder:7b-instruct
RERANKER_LLM_MODEL=qwen3-coder:30b-a3b-q4_K_M
TASK_STATE_LLM_MODEL=qwen2.5-coder:7b-instruct

# RAG Server — behaviour
SEARCH_TOP_K=5
FORCE_REINDEX=false
EXTRACT_METADATA=true
TRANSLATE_QUERIES=true

# RAG Server — optional
# OPENROUTER_API_KEY=

# AI Gateway — rate limiting and context
RATE_LIMIT_RPM=60
CONCURRENCY_LIMIT=4
OLLAMA_MAX_CONTEXT=8192

# MCP Server — GitHub integration
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=
